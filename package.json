{
  "name": "yzgc-admin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm check:runtime && pnpm check:site-config && pnpm --filter @yzgc/server build && pnpm --filter @yzgc/web build && pnpm --filter @yzgc/console build",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:site-config": "node scripts/check-site-config.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docs:index": "node scripts/docs-index.mjs",
    "check:docs": "node scripts/docs-index.mjs --check && node scripts/check-docs.mjs && node scripts/tuffex-docs.mjs check",
    "docs:tuffex": "node scripts/tuffex-docs.mjs",
    "check:tuffex-docs": "node scripts/tuffex-docs.mjs check",
    "release:plan":"node scripts/release-policy.mjs",
    "check:environments":"node scripts/deployment-environment.mjs --check",
    "check:branch-invariants":"node scripts/check-branch-invariants.mjs",
    "hooks:enable":"git config core.hooksPath .githooks",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:notes": "node scripts/note.mjs check",
    "typecheck": "tsc -p app/server/tsconfig.json --noEmit && tsc -p app/web/tsconfig.json --noEmit && pnpm --filter @yzgc/console typecheck",
    "check": "pnpm check:runtime && pnpm check:site-config && pnpm check:environments && pnpm check:boundaries && pnpm check:docs && pnpm check:notes && pnpm check:secrets && pnpm typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm forum:check && pnpm forum:generate",
    "forum:install": "node scripts/forum.mjs install",
    "forum:dev": "node scripts/forum.mjs dev --host 127.0.0.1",
    "forum:start": "node scripts/forum.mjs start",
    "forum:status": "node scripts/forum.mjs status",
    "forum:stop": "node scripts/forum.mjs stop",
    "forum:check": "node scripts/forum.mjs check",
    "forum:generate": "node scripts/forum.mjs generate",
    "forum:verify": "node scripts/forum.mjs verify",
    "preview:local": "node scripts/local-preview.mjs start && node scripts/forum.mjs start",
    "dev:web": "pnpm --filter @yzgc/web dev",
    "dev:console": "pnpm --filter @yzgc/console dev",
    "dev": "pnpm -r --parallel run dev",
    "start": "node scripts/check-runtime.mjs && node app/server/dist/index.js"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "@playwright/test": "^1.55.0"
  },
  "pnpm": {
    "overrides": {
      "@unocss/inspector>@vitejs/devtools-kit": "0.7.3"
    },
    "packageExtensions": {
      "@talex-touch/utils": {
        "peerDependenciesMeta": {
          "electron": {
            "optional": true
          }
        }
      },
      "unocss@66.10.2": {
        "peerDependencies": {
          "vite": "^7.0.0"
        }
      }
    }
  }
}
