{
  "name": "yzgc-admin",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm check:runtime && pnpm check:site-config && pnpm --filter @yzgc/server build && pnpm --filter @yzgc/web build && pnpm --filter @yzgc/console build",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:site-config": "node scripts/check-site-config.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docs:index": "node scripts/docs-index.mjs",
    "catalog:generate": "pnpm --filter @yzgc/server exec tsx ../../scripts/project-catalog.ts generate",
    "check:catalog": "pnpm --filter @yzgc/server exec tsx ../../scripts/project-catalog.ts check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/docs-index.mjs --check && node scripts/check-docs.mjs && node scripts/tuffex-docs.mjs check",
    "docs:tuffex": "node scripts/tuffex-docs.mjs",
    "check:tuffex-docs": "node scripts/tuffex-docs.mjs check",
    "release:plan": "node scripts/release-policy.mjs",
    "contest:site": "node scripts/contest-site.mjs",
    "check:environments": "node scripts/deployment-environment.mjs --check",
    "check:env-isolation": "node scripts/check-env-isolation.mjs",
    "check:branch-invariants": "node scripts/check-branch-invariants.mjs",
    "hooks:enable": "git config core.hooksPath .githooks",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:notes": "node scripts/note.mjs check",
    "check:doc-sync": "node scripts/check-doc-sync.mjs",
    "check:cli": "node scripts/check-cli.mjs",
    "cli:build": "cargo build --manifest-path app/cli/Cargo.toml --locked --jobs 2",
    "cli:test": "cargo test --manifest-path app/cli/Cargo.toml --locked --jobs 2 -- --test-threads=1",
    "cli:dist": "node scripts/cli-dist.mjs",
    "typecheck:catalog": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict --esModuleInterop --skipLibCheck --types node scripts/project-catalog.ts",
    "typecheck": "tsc -p app/server/tsconfig.json --noEmit && tsc -p app/web/tsconfig.json --noEmit && pnpm --filter @yzgc/console typecheck && pnpm typecheck:catalog",
    "check": "pnpm check:runtime && pnpm check:site-config && pnpm check:environments && pnpm check:env-isolation && pnpm check:boundaries && pnpm check:docs && pnpm check:doc-sync && pnpm check:notes && pnpm check:secrets && pnpm check:privacy && pnpm check:catalog && pnpm check:architecture && pnpm check:cli && pnpm typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm forum:check && pnpm forum:generate",
    "forum:install": "node scripts/forum.mjs install",
    "forum:dev": "node scripts/forum.mjs dev --host 127.0.0.1",
    "forum:start": "node scripts/forum.mjs start",
    "forum:status": "node scripts/forum.mjs status",
    "forum:stop": "node scripts/forum.mjs stop",
    "forum:check": "node scripts/forum.mjs check",
    "forum:generate": "node scripts/forum.mjs generate",
    "forum:verify": "node scripts/forum.mjs verify",
    "preview:local": "node scripts/local-preview.mjs start && node scripts/forum.mjs start",
    "local:up": "node scripts/local-stack.mjs up",
    "local:down": "node scripts/local-stack.mjs down",
    "local:status": "node scripts/local-stack.mjs status",
    "dev:web": "pnpm --filter @yzgc/web dev",
    "dev:console": "pnpm --filter @yzgc/console dev",
    "dev": "pnpm -r --parallel run dev",
    "start": "node scripts/check-runtime.mjs && node app/server/dist/index.js"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@unocss/inspector>@vitejs/devtools-kit": "0.7.3"
    },
    "packageExtensions": {
      "@talex-touch/utils": {
        "peerDependenciesMeta": {
          "electron": {
            "optional": true
          }
        }
      },
      "unocss@66.10.2": {
        "peerDependencies": {
          "vite": "^7.0.0"
        }
      }
    }
  }
}
