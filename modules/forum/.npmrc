# pnpm 11 reads pnpm-specific settings from pnpm-workspace.yaml, which is the
# authoritative copy. These two are repeated here for older pnpm versions:
# @talex-touch/utils (a tuffex runtime dependency) declares an `electron` peer
# and Electron must never be installed for this Nuxt app.
auto-install-peers=false
strict-peer-dependencies=false
