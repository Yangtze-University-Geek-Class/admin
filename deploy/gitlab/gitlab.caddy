# 旧 GitLab 地址只做跳转（#335）：GitLab 搬到正式入口的 /gitlab 下，路径和查询串原样带过去，git clone/fetch/push 跟着 301 走。
# 香港 /etc/caddy/sites/gitlab.caddy 的唯一来源：install-host.sh --target edge 把它装到 /usr/local/share/yzgc-edge/gitlab-legacy.caddy，
# 受限入口 production-apply 核对它只把这个主机跳到 <正式 PUBLIC_ORIGIN>/gitlab 之后才替换原来的反代块；NANO 头像随 GitLab 一起搬到 /gitlab/nano-avatar/。
git.yangtzeu.work {
	redir https://yangtzeu.work/gitlab{uri} 301
}
