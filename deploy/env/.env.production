# ─────────────────────────────────────────────────────────────
# 正式环境（production）· 入口 https://yangtzeu.work
#
# 本文件入库：所有服务地址、域名、端口、路径都是可见的部署事实，
# 直接写真实值，机器与人都能一眼看清「正式环境长什么样」。
# 密钥项一律留空 —— 由 CI/CD 用 GitHub Environment `production` 的
# secrets 渲染到目标机 <STACK_ROOT>/.env.production，仓库里永远没有真值。
#
# 目标机运行时路径：/opt/yzgc/production/.env.production
# compose 调用：docker compose --env-file <此文件> -f deploy/compose/production.yml
# ─────────────────────────────────────────────────────────────

# ── 环境身份（与 deploy/environments.json 必须一致）───────────
GEEK_DEPLOYMENT_ENVIRONMENT=production
GEEK_ENVIRONMENT_ORIGIN=https://yangtzeu.work
COMPOSE_PROJECT_NAME=yzgc-production
STACK_ROOT=/opt/yzgc/production

# ── 部署目标机（经中继跳板访问 Arch；地址直接暴露；私钥只存在于 GitHub secrets）────
DEPLOY_HOST=10.66.0.2
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_PROXY_JUMP=root@156.238.244.78:22
# ── 镜像标签（由部署流程写入当前发布 SHA 前 12 位）────────────
IMAGE_TAG=unset

# ── 端口：Arch tun0 接口（Caddy 反代入口）+ 宿主回环 + 容器内端口 ──────────
WEB_BIND=10.66.0.2:18100
SERVER_BIND=127.0.0.1:18101
SERVER_PORT=3000
FORUM_PORT=3000
# ── 对外地址：每个环境只有这一个 origin ───────────────────────
# 官网、管理端（/admin、/console）、论坛（/forum）都在它下面，按路径区分。
# OAuth 回调固定为 <PUBLIC_ORIGIN>/auth/callback，必须与 GitHub OAuth App 登记值一致。
# 必须逐字等于 deploy/environments.json 的 production.origin。
PUBLIC_ORIGIN=https://yangtzeu.work

# ── 运行时 ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# 容器内必须监听 0.0.0.0，否则 compose 网络里的 web 容器连不上
HOST=0.0.0.0
# 反代层数：香港 Caddy → web 容器 nginx → server，共 2 层。Caddy 重建可信客户端地址，
# 客户端自己填的部分不算数；写 true 会把最左边（客户端能伪造）当成客户端 IP，按 IP 的限流就失效了
TRUST_PROXY=2
DB_PATH=/data/data.db
FORUM_DB_PATH=/data/forum.db
FORUM_UPLOAD_DIR=/data/forum-uploads
# 正式环境只设 host-only cookie（留空即不写 Domain），禁止 .yangtzeu.work
COOKIE_DOMAIN=
POW_DIFFICULTY=3
# ── 访问防护（#333）：按真实客户端 IP 累计异常信号，超过阈值自动封禁，再犯逐级加长；全站每个北京日的上限 ──
# 阈值按 10 分钟计，封禁从 15 分钟起；校园出口 NAT（一个 IP 后面很多人）的正常使用不能被误伤，所以默认值留了余量。
# 白名单网段（SHIELD_ALLOWLIST）是密钥段里的一项，留空 = 没有豁免。SHIELD_ENABLED 与 SHIELD_ALLOWLIST 也传给 web 容器：nginx 第一层限流 off 时不限、白名单来源不计。
SHIELD_ENABLED=on
SHIELD_THRESHOLD=120
SHIELD_WINDOW_MINUTES=10
SHIELD_BLOCK_MINUTES=15,60,360,1440
SHIELD_DECAY_HOURS=24
SITE_QUOTA_EMAIL_DAILY=2000
SITE_QUOTA_REGISTER_DAILY=300
SITE_QUOTA_FEEDBACK_DAILY=200
SITE_QUOTA_DEVICE_CODE_DAILY=500
EMAIL_RECIPIENT_QUOTA_DAILY=10
REGISTER_NO_COOKIE_IP_DAILY=3

# ── 发信（投递后的来信与状态变更通知）─────────────────────────
# 信里图片的前缀、收件范围是可见事实；发件地址（下面两行）是环境 secrets，留空不写进文件；AccessKey、Resend 密钥和收件名单在下面的密钥段。
# Arch 已接管原正式环境，沿用既有收件范围；隔离恢复副本另按 BACKUP/ENVIRONMENTS 关闭外发。
# MAIL_REPLY_TO 留空 = 不带 Reply-To，信里改请对方到官网意见箱留言。
MAIL_ALIYUN_FROM=
MAIL_RESEND_FROM=
MAIL_ASSET_BASE=https://cdn.crosery.com/yzgc/mail/v1/
MAIL_REPLY_TO=
MAIL_RECIPIENTS=all
# ── 自建 GitLab（#270）────────────────────────────────────────
# 账号同步：off 不同步，dry-run 只算出要做什么，on 照做（要下面密钥段的 GITLAB_API_TOKEN）。
# 正式环境在预发布验收、目标机填好令牌之后才改成 on；令牌空时写 on，server 启动失败。
# 现有 GitLab 保留为正式。旧预发布写者排空、原 sub/用户 ID 完整对账后才开启正式同步并切换签发者。
# 地址和预发布一样是本环境入口下的 /gitlab（#335）；GITLAB_OIDC_SECTOR 是 gitlab 客户端钉住的 sector，沿用搬家前的主机，成员的 sub 不变。
GITLAB_SYNC=off
GITLAB_URL=https://yangtzeu.work/gitlab
GITLAB_GROUP=geek
GITLAB_OIDC_CLIENT=gitlab
GITLAB_OIDC_SECTOR=git.yangtzeu.work
GITLAB_STACK_ROOT=/srv/gitlab
GITLAB_HTTP_BIND=10.66.0.2:8929
GITLAB_DOCKER_SUBNET=172.31.29.0/24
GITLAB_DOCKER_GATEWAY=172.31.29.1

# ── 发布身份（由 CI/CD 传 build args，不在这里写死）────────────
# 正式（tag vX.Y.Z）：GEEK_RELEASE_VERSION=<X.Y.Z>，禁止任何后缀
# 预发布（tag vX.Y.Z-rc.N / -hf.N / -stable.N）：GEEK_RELEASE_VERSION=<X.Y.Z-rc.N | X.Y.Z-hf.N | X.Y.Z-stable>@<commit 前 12 位>
# 两者都带 GEEK_RELEASE_COMMIT=<完整 40 位 SHA>，供论坛 about 页显示与校验。

# ── 密钥：留空，由 CI/CD 注入，禁止写入仓库 ───────────────────
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 发信密钥都可以不配：阿里云两项要么都填要么都空；阿里云与 Resend 都空 = 不发信
MAIL_ALIYUN_ACCESS_KEY_ID=
MAIL_ALIYUN_ACCESS_KEY_SECRET=
MAIL_RESEND_API_KEY=
# 收件名单：MAIL_RECIPIENTS=allowlist 时才用；英文逗号隔开的邮箱、不带空格，是个人信息，所以按密钥存
MAIL_ALLOWLIST=
# 访问防护的网段白名单（#333）：英文逗号隔开的 IP 或 CIDR，命中的来源永远不计分、不封禁。按密钥存，和收件名单一样：空 = 没有豁免。
SHIELD_ALLOWLIST=
# Google 登录（可选的一对）：都空 = 登录页不出现 Google；在 Google Cloud 建 OAuth 客户端，回调地址填 <PUBLIC_ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 对外授权的签名私钥（#270）：空 = /oidc/* 一律 404，GitLab 不能用极客班账号登录。生成：node app/server/dist/cli/oidc.js keygen
OIDC_JWKS=
# GitLab 管理员令牌（api 范围，#270）：GITLAB_SYNC=on 时必填
GITLAB_API_TOKEN=
