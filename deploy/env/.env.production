# ─────────────────────────────────────────────────────────────
# 正式环境（production）· 入口 https://yangtzeu.work
#
# 本文件入库：所有服务地址、域名、端口、路径都是可见的部署事实，
# 直接写真实值，机器与人都能一眼看清「正式环境长什么样」。
# 密钥项一律留空 —— 由 CI/CD 用 GitHub Environment `production` 的
# secrets 渲染到目标机 <STACK_ROOT>/.env.production，仓库里永远没有真值。
#
# 目标机运行时路径：/opt/yzgc/production/.env.production
# compose 调用：docker compose --env-file <此文件> -f deploy/compose/production.yml
# ─────────────────────────────────────────────────────────────

# ── 环境身份（与 deploy/environments.json 必须一致）───────────
GEEK_DEPLOYMENT_ENVIRONMENT=production
GEEK_ENVIRONMENT_ORIGIN=https://yangtzeu.work
COMPOSE_PROJECT_NAME=yzgc-production
STACK_ROOT=/opt/yzgc/production

# ── 部署目标机（地址直接暴露；私钥只存在于 GitHub secrets）────
DEPLOY_HOST=103.117.123.226
DEPLOY_PORT=22000
DEPLOY_USER=root

# ── 镜像标签（由部署流程写入当前发布 SHA 前 12 位）────────────
IMAGE_TAG=unset

# ── 端口：宿主回环（nginx 反代入口）+ 容器内端口 ──────────────
WEB_BIND=127.0.0.1:18100
SERVER_BIND=127.0.0.1:18101
SERVER_PORT=3000
FORUM_PORT=3000

# ── 对外地址（后端 OAuth 回调、跨站跳转的真实来源）───────────
PUBLIC_ORIGIN=https://github.yangtzeu.work
SITE_ORIGIN=https://yangtzeu.work
ADMIN_HOST=github.yangtzeu.work
PORTAL_HOST=yangtzeu.work
FORUM_HOST=yangtzeu.work

# ── 运行时 ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# 容器内必须监听 0.0.0.0，否则 compose 网络里的 web 容器连不上
HOST=0.0.0.0
# 反代来自 compose 网络而非回环，必须显式信任 X-Forwarded-*
TRUST_PROXY=true
DB_PATH=/data/data.db
FORUM_DB_PATH=/data/forum.db
FORUM_UPLOAD_DIR=/data/forum-uploads
# 正式环境只设 host-only cookie（留空即不写 Domain），禁止 .yangtzeu.work
COOKIE_DOMAIN=
POW_DIFFICULTY=3
ALLOWED_ORGS=

# ── 发布身份（由 CI/CD 传 build args，不在这里写死）────────────
# 正式：GEEK_RELEASE_VERSION=<package.json 的 X.Y.Z>，禁止 @ 后缀
# 预发布：GEEK_RELEASE_VERSION=<X.Y.Z>@<commit 前 12 位>
# 两者都带 GEEK_RELEASE_COMMIT=<完整 40 位 SHA>，供论坛 about 页显示与校验。

# ── 密钥：留空，由 CI/CD 注入，禁止写入仓库 ───────────────────
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
