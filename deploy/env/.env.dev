# ─────────────────────────────────────────────────────────────
# 本机开发（dev）· 入口 http://127.0.0.1:5173
#
# 与 .env.production、.env.preview 同一份键集（scripts/check-env-isolation.mjs 逐键核对），
# 值只指向本机：回环地址、.tools/local-preview 下的数据、不外发邮件、不同步 GitLab。
# 本文件入库；密钥留空，需要真实 GitHub 登录等再在 shell 或仓库根 `.env` 里补，不写进这里。
#
# 用法：cp deploy/env/.env.dev .env，补上 SESSION_SECRET / ENCRYPTION_KEY 等本机用的随机值；
# 只做界面预览时不需要，直接 pnpm dev:web 或 pnpm preview:local（隔离模式，内存库）。
# 部署相关的键（DEPLOY_*、STACK_ROOT、镜像标签）在本机没有目标，留空。
# ─────────────────────────────────────────────────────────────

# ── 环境身份（本机的标识沿用论坛构建里的 local）────────────────
GEEK_DEPLOYMENT_ENVIRONMENT=local
GEEK_ENVIRONMENT_ORIGIN=http://127.0.0.1:5173
COMPOSE_PROJECT_NAME=yzgc-dev
STACK_ROOT=

# ── 部署目标机：本机没有 ──────────────────────────────────────
DEPLOY_HOST=
DEPLOY_PORT=
DEPLOY_USER=
DEPLOY_PROXY_JUMP=
IMAGE_TAG=unset

# ── 端口：全部绑回环 ──────────────────────────────────────────
WEB_BIND=127.0.0.1:5173
SERVER_BIND=127.0.0.1:3000
SERVER_PORT=3000
FORUM_PORT=3456
# ── 对外地址：官网、管理端、论坛同一个 origin，按路径区分 ─────
# 本机 OAuth 应用的回调登记 <PUBLIC_ORIGIN>/auth/callback。
PUBLIC_ORIGIN=http://127.0.0.1:5173

# ── 运行时 ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# 本机不设反代层数（只信任回环上的开发代理）
TRUST_PROXY=
DB_PATH=./.tools/local-preview/core.db
FORUM_DB_PATH=./.tools/local-preview/forum.db
FORUM_UPLOAD_DIR=./.tools/local-preview/forum-uploads
COOKIE_DOMAIN=
POW_DIFFICULTY=0
# ── 访问防护（#333）：按真实客户端 IP 累计异常信号，超过阈值自动封禁，再犯逐级加长；全站每个北京日的上限 ──
# 阈值按 10 分钟计，封禁从 15 分钟起；校园出口 NAT（一个 IP 后面很多人）的正常使用不能被误伤，所以默认值留了余量。
# 白名单网段（SHIELD_ALLOWLIST）是密钥段里的一项，留空 = 没有豁免。SHIELD_ENABLED 与 SHIELD_ALLOWLIST 也传给 web 容器：nginx 第一层限流 off 时不限、白名单来源不计。
SHIELD_ENABLED=off
SHIELD_THRESHOLD=120
SHIELD_WINDOW_MINUTES=10
SHIELD_BLOCK_MINUTES=15,60,360,1440
SHIELD_DECAY_HOURS=24
SITE_QUOTA_EMAIL_DAILY=2000
SITE_QUOTA_REGISTER_DAILY=300
SITE_QUOTA_FEEDBACK_DAILY=200
SITE_QUOTA_DEVICE_CODE_DAILY=500
EMAIL_RECIPIENT_QUOTA_DAILY=10
REGISTER_NO_COOKIE_IP_DAILY=3

# ── 发信：本机只能走收件名单，名单默认为空 = 谁也不发 ─────────
MAIL_ALIYUN_FROM=
MAIL_RESEND_FROM=
MAIL_ASSET_BASE=https://cdn.yangtzeu.work/geek-public/mail/v1/
MAIL_REPLY_TO=
MAIL_RECIPIENTS=allowlist
# ── 自建 GitLab：本机永远不同步 ───────────────────────────────
GITLAB_SYNC=off
GITLAB_URL=http://127.0.0.1:8930/gitlab
GITLAB_GROUP=geek
GITLAB_OIDC_CLIENT=gitlab
GITLAB_OIDC_SECTOR=127.0.0.1:8930
GITLAB_STACK_ROOT=./.tools/local-preview/gitlab
GITLAB_HTTP_BIND=127.0.0.1:8930
GITLAB_DOCKER_SUBNET=172.31.31.0/24
GITLAB_DOCKER_GATEWAY=172.31.31.1

# ── 密钥：留空，本机需要时在 shell 或 .env 里补，禁止写入仓库 ─
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MAIL_ALIYUN_ACCESS_KEY_ID=
MAIL_ALIYUN_ACCESS_KEY_SECRET=
MAIL_RESEND_API_KEY=
MAIL_ALLOWLIST=
# 访问防护的网段白名单（#333）：英文逗号隔开的 IP 或 CIDR，命中的来源永远不计分、不封禁。按密钥存，和收件名单一样：空 = 没有豁免。
SHIELD_ALLOWLIST=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_JWKS=
GITLAB_API_TOKEN=
