# ─────────────────────────────────────────────────────────────
# 预发布环境（preview）· 入口 https://prev.yangtzeu.work
#
# 由 `stage` 分支自动部署。与正式环境完全隔离：独立栈目录、独立 compose
# 项目、独立数据卷、独立端口、独立密钥；不共享任何运行数据。
# 本文件入库、只写可见的地址与端口，密钥留空由 CI/CD 注入。
#
# 目标机运行时路径：/opt/yzgc/preview/.env.preview
# compose 调用：docker compose --env-file <此文件> -f deploy/compose/preview.yml
# ─────────────────────────────────────────────────────────────

# ── 环境身份（与 deploy/environments.json 必须一致）───────────
GEEK_DEPLOYMENT_ENVIRONMENT=preview
GEEK_ENVIRONMENT_ORIGIN=https://prev.yangtzeu.work
COMPOSE_PROJECT_NAME=yzgc-preview
STACK_ROOT=/opt/yzgc/preview

# ── 部署目标机（与正式同机、不同栈；私钥只存在于 GitHub secrets）─
DEPLOY_HOST=103.117.123.226
DEPLOY_PORT=22000
DEPLOY_USER=root

# ── 镜像标签（由部署流程写入当前发布 SHA 前 12 位）────────────
IMAGE_TAG=unset

# ── 端口：与正式环境必须不同 ──────────────────────────────────
WEB_BIND=127.0.0.1:18200
SERVER_BIND=127.0.0.1:18201
SERVER_PORT=3000
FORUM_PORT=3000

# ── 对外地址（预发布域名；管理员端另用 prev-admin 子域）───────
PUBLIC_ORIGIN=https://prev-admin.yangtzeu.work
SITE_ORIGIN=https://prev.yangtzeu.work
ADMIN_HOST=prev-admin.yangtzeu.work
PORTAL_HOST=prev.yangtzeu.work
FORUM_HOST=prev.yangtzeu.work

# ── 运行时 ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=true
DB_PATH=/data/data.db
FORUM_DB_PATH=/data/forum.db
FORUM_UPLOAD_DIR=/data/forum-uploads
COOKIE_DOMAIN=
POW_DIFFICULTY=3
ALLOWED_ORGS=
# 极客班控制台固定管理的 GitHub 组织（非密钥）；ALLOWED_ORGS 非空时必须包含它
CONSOLE_ORG=Yangtze-University-Geek-Class

# ── 发布身份（由 CI/CD 传 build args，不在这里写死）────────────
# 预发布展示 `X.Y.Z@<commit 前 12 位>`；正式展示 `X.Y.Z` 且禁止 @。
# 两者都必须同时传 GEEK_RELEASE_COMMIT=<完整 40 位 SHA>。

# ── 密钥：留空，由 CI/CD 注入，禁止写入仓库 ───────────────────
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
