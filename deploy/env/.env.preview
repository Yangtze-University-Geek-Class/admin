# ─────────────────────────────────────────────────────────────
# 预发布环境（preview）· 入口 https://prev.yangtzeu.work
#
# 由打在 `stage` 提交上的发布 tag `vX.Y.Z-rc.N` 部署（deploy-preview.yml），
# 推送 `stage` 本身不部署。与正式环境完全隔离：独立栈目录、独立 compose
# 项目、独立数据卷、独立端口、独立密钥；不共享任何运行数据。
# 本文件入库、只写可见的地址与端口，密钥留空由 CI/CD 注入。
#
# 目标机运行时路径：/opt/yzgc/preview/.env.preview
# compose 调用：docker compose --env-file <此文件> -f deploy/compose/preview.yml
# ─────────────────────────────────────────────────────────────

# ── 环境身份（与 deploy/environments.json 必须一致）───────────
GEEK_DEPLOYMENT_ENVIRONMENT=preview
GEEK_ENVIRONMENT_ORIGIN=https://prev.yangtzeu.work
COMPOSE_PROJECT_NAME=yzgc-preview
STACK_ROOT=/opt/yzgc/preview

# ── 部署目标机（与正式同机、不同栈；私钥只存在于 GitHub secrets）─
DEPLOY_HOST=103.117.123.226
DEPLOY_PORT=22000
DEPLOY_USER=root

# ── 镜像标签（由部署流程写入当前发布 SHA 前 12 位）────────────
IMAGE_TAG=unset

# ── 端口：与正式环境必须不同 ──────────────────────────────────
WEB_BIND=127.0.0.1:18200
SERVER_BIND=127.0.0.1:18201
SERVER_PORT=3000
FORUM_PORT=3000

# ── 对外地址：每个环境只有这一个 origin ───────────────────────
# 官网、管理端（/admin、/console）、论坛（/forum）都在它下面，按路径区分。
# OAuth 回调固定为 <PUBLIC_ORIGIN>/auth/callback；预发布用自己的 GitHub OAuth App，
# 密钥不与正式环境共用。必须逐字等于 deploy/environments.json 的 preview.origin。
PUBLIC_ORIGIN=https://prev.yangtzeu.work

# ── 运行时 ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# 反代层数：宿主 nginx → web 容器 nginx → server，共 2 层（同正式环境，不能写 true）
TRUST_PROXY=2
DB_PATH=/data/data.db
FORUM_DB_PATH=/data/forum.db
FORUM_UPLOAD_DIR=/data/forum-uploads
COOKIE_DOMAIN=
POW_DIFFICULTY=3
ALLOWED_ORGS=
# 极客班控制台固定管理的 GitHub 组织（非密钥）；ALLOWED_ORGS 非空时必须包含它
CONSOLE_ORG=Yangtze-University-Geek-Class

# ── 发信（投递后的来信与状态变更通知）─────────────────────────
# 发件地址、信里图片的前缀、收件范围是可见事实；AccessKey、Resend 密钥和收件名单在下面的密钥段。
# 预发布和正式一样发给所有投递人（#169，所有者 2026-09-27 要求预发布的信都发出去）；改成 allowlist 就只发 MAIL_ALLOWLIST 里的地址。
# MAIL_REPLY_TO 留空 = 不带 Reply-To，信里改请对方到官网意见箱留言。
MAIL_ALIYUN_FROM=notify@mail.email-crosery.cn
MAIL_RESEND_FROM=notify@email-crosery.cn
MAIL_ASSET_BASE=https://cdn.crosery.com/yzgc/mail/v1/
MAIL_REPLY_TO=
MAIL_RECIPIENTS=all

# ── 发布身份（由 CI/CD 传 build args，不在这里写死）────────────
# 预发布（tag vX.Y.Z-rc.N）展示 `X.Y.Z-rc.N@<commit 前 12 位>`；正式（tag vX.Y.Z）展示 `X.Y.Z`，禁止任何后缀。
# 两者都必须同时传 GEEK_RELEASE_COMMIT=<完整 40 位 SHA>。

# ── 密钥：留空，由 CI/CD 注入，禁止写入仓库 ───────────────────
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 发信密钥都可以不配：阿里云两项要么都填要么都空；阿里云与 Resend 都空 = 不发信
MAIL_ALIYUN_ACCESS_KEY_ID=
MAIL_ALIYUN_ACCESS_KEY_SECRET=
MAIL_RESEND_API_KEY=
# 收件名单（只在 MAIL_RECIPIENTS=allowlist 时起作用，现在不用）：英文逗号隔开的邮箱、不带空格；是个人信息，所以按密钥存
MAIL_ALLOWLIST=
