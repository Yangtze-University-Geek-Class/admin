# OAuth App credentials (build at https://github.com/organizations/<org>/settings/applications/new)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Server
PORT=3000
PUBLIC_ORIGIN=https://github.yangtzeu.work
# 可选：跨站跳转与邀请链接生成时的主站来源（默认取 PUBLIC_ORIGIN）
# SITE_ORIGIN=https://yangtzeu.work
# 可选：多子域共享 session 时指定 cookie 域（如 .yangtzeu.work）
# COOKIE_DOMAIN=

# Session cookie signing
SESSION_SECRET=

# SQLite path
DB_PATH=./data/data.db
# 可选：论坛独立数据库路径（默认与 DB_PATH 同目录下的 forum.db）
# FORUM_DB_PATH=./data/forum.db

# Cloudflare Turnstile (optional — leave blank to skip captcha)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Encryption key for service-token at rest (32 bytes base64)
ENCRYPTION_KEY=

# Proof-of-Work difficulty for public submissions (default 3; 4/5 更慢更稳)
# POW_DIFFICULTY=3

# 可选：仅允许指定 org 使用（逗号分隔的小写 login，留空不限制）
# ALLOWED_ORGS=
