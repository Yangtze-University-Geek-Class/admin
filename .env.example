# ─────────────────────────────────────────────────────────────
# 服务端环境变量。复制成 .env 后填写；.env 不进版本库。
#
# systemd 通过 EnvironmentFile=/opt/yzgc-admin/.env 读取（见 deploy/yzgc-admin.service）。
# 改完要 systemctl restart yzgc-admin 才生效。
#
# 注意：前端的域名、标题、功能开关**不在**这里 —— 它们是构建期常量，
# 写在 web/shared/config/app.config.json，随 pnpm --filter @yzgc/web build
# 一起烤进产物。两处都涉及域名的只有一项，见下方 SITE_HOSTS 一节。
# ─────────────────────────────────────────────────────────────

# ── GitHub OAuth App ──────────────────────────────────────────
# 在 https://github.com/organizations/<org>/settings/applications/new 创建
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ── 服务 ──────────────────────────────────────────────────────
PORT=3000

# 管理后台的对外地址。OAuth 回调固定为 <PUBLIC_ORIGIN>/auth/callback，
# 必须与 GitHub OAuth App 里登记的 Callback URL 完全一致。
PUBLIC_ORIGIN=https://github.yangtzeu.work

# 官网对外地址。邀请链接生成与跨站跳转会用到。
SITE_ORIGIN=https://yangtzeu.work

# 可选：多子域共享 session 时指定 cookie 域（如 .yangtzeu.work）
# COOKIE_DOMAIN=

# ── 站点域名映射 ──────────────────────────────────────────────
# 用于把 SPA fallback 指到对应的 index.html（server/src/config.ts 的 siteHosts）。
# 三个都有默认值，由上面两个 ORIGIN 推导，通常不用填：
#   admin  ← PUBLIC_ORIGIN
#   portal ← SITE_ORIGIN
#   forum  ← forum.<SITE_ORIGIN 的域名>
#
# ⚠ 这三个域名在前端也有一份：web/shared/config/app.config.json 的 sites.*.host。
#   前端那份是构建期常量（Vite 的 VITE_* 会烤进产物，且不是运行时秘密，所以
#   不放这里）。**改域名时两边都要改**，否则跨站链接会指向不存在的地址。
# ADMIN_HOST=github.yangtzeu.work
# PORTAL_HOST=yangtzeu.work
# FORUM_HOST=forum.yangtzeu.work

# ── 会话与加密 ────────────────────────────────────────────────
# 签名 cookie 用；换掉会让所有人重新登录
SESSION_SECRET=
# 加密落库的 access token（AES-256-GCM），必须正好 32 字节 base64
# 换掉会让已有 session 与 invite_links 不可读，迁移前先想清楚
ENCRYPTION_KEY=

# ── 数据库 ────────────────────────────────────────────────────
DB_PATH=./data/data.db
# 可选：论坛独立库路径（默认与 DB_PATH 同目录下的 forum.db）
# FORUM_DB_PATH=./data/forum.db
# 可选：论坛上传目录（默认 ./data/forum-uploads）
# FORUM_UPLOAD_DIR=./data/forum-uploads

# ── 防滥用 ────────────────────────────────────────────────────
# Cloudflare Turnstile（可选 —— 留空则不启用验证码）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 公开表单的 PoW 难度，默认 3（16^3 次哈希，低端机也是毫秒级）；4/5 更慢更稳
# POW_DIFFICULTY=3

# ── 组织范围 ──────────────────────────────────────────────────
# 可选：仅允许指定 org 使用（逗号分隔的小写 login，留空不限制）
# ALLOWED_ORGS=

# ── 运行模式 ──────────────────────────────────────────────────
# 可选：production 时 Fastify 关闭 pino-pretty 美化输出
# NODE_ENV=production
