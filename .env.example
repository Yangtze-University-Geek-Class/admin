# OAuth App credentials (build at https://github.com/organizations/<org>/settings/applications/new)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Org identity
ORG=Yangtze-University-Geek-Class
ADMIN_LOGIN=Crosery

# Server
PORT=3000
PUBLIC_ORIGIN=https://github.yangtzeu.work

# Session cookie signing
SESSION_SECRET=

# SQLite path
DB_PATH=./data/data.db

# Cloudflare Turnstile (optional — leave blank to skip captcha)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Encryption key for service-token at rest (32 bytes base64)
ENCRYPTION_KEY=
