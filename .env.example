# ─────────────────────────────────────────────────────────────
# 本地开发用环境变量模板。复制成仓库根目录的 `.env` 后填写；
# `.env` 不进版本库（.gitignore），也不要在里面放生产凭据。
#
# 部署环境**不用这个文件**：正式与预发布各自一份，见
#   deploy/env/.env.production   正式（yangtzeu.work）
#   deploy/env/.env.preview      预发布（prev.yangtzeu.work）
# 那两份入库，只写地址/端口/域名这类可见事实，密钥留空由 CI/CD 注入。
#
# 注意：前端的域名、标题、功能开关是**构建期常量**，写在
# app/web/shared/config/app.config.json（随 pnpm --filter @yzgc/web build 烤进产物）。
# 部署镜像前由 scripts/render-web-config.mjs 按环境重写其中的 host。
# ─────────────────────────────────────────────────────────────

# ── GitHub OAuth App ──────────────────────────────────────────
# 在 https://github.com/organizations/<org>/settings/applications/new 创建
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ── 服务 ──────────────────────────────────────────────────────
PORT=3000
# 监听地址；容器部署必须 0.0.0.0（见 deploy/env/.env.<环境>），本机保持默认回环
# HOST=127.0.0.1
# 反代是否为可信来源：loopback（默认，仅本机反代）/ true / false / CIDR
# TRUST_PROXY=loopback

# 管理后台的对外地址。OAuth 回调固定为 <PUBLIC_ORIGIN>/auth/callback，
# 必须与 GitHub OAuth App 里登记的 Callback URL 完全一致。
PUBLIC_ORIGIN=http://127.0.0.1:5173

# 官网对外地址。邀请链接生成与跨站跳转会用到。
SITE_ORIGIN=http://127.0.0.1:5173

# 可选：多子域共享 session 时指定 cookie 域（生产环境必须留空以保持 host-only）
# COOKIE_DOMAIN=

# ── 站点域名映射 ──────────────────────────────────────────────
# 用于把 SPA fallback 指到对应的 index.html（app/server/src/config.ts 的 siteHosts）。
# 三个都有默认值，由上面两个 ORIGIN 推导，通常不用填：
#   admin  ← PUBLIC_ORIGIN
#   portal ← SITE_ORIGIN
#   forum  ← PORTAL_HOST（论坛挂在官网域名的 /forum 路径下，不是独立子域）
#
# ⚠ 这三个域名在前端也有一份：app/web/shared/config/app.config.json 的 sites.*.host。
#   前端那份是构建期常量。**改域名时两边都要改**，否则跨站链接会指向不存在的地址。
# ADMIN_HOST=github.yangtzeu.work
# PORTAL_HOST=yangtzeu.work
# FORUM_HOST=yangtzeu.work

# ── 会话与加密 ────────────────────────────────────────────────
# 签名 cookie 用；换掉会让所有人重新登录
SESSION_SECRET=
# 加密落库的 access token（AES-256-GCM），必须正好 32 字节 base64
# 换掉会让已有 session 与 invite_links 不可读，迁移前先想清楚
ENCRYPTION_KEY=

# ── 数据库 ────────────────────────────────────────────────────
# 当前数据层是 better-sqlite3；容器部署用命名卷里的 /data/data.db
DB_PATH=./data/data.db
# 可选：论坛独立库路径（默认与 DB_PATH 同目录下的 forum.db）
# FORUM_DB_PATH=./data/forum.db
# 可选：论坛上传目录（默认 ./data/forum-uploads）
# FORUM_UPLOAD_DIR=./data/forum-uploads

# ── 防滥用 ────────────────────────────────────────────────────
# Cloudflare Turnstile（可选 —— 留空则不启用验证码）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 公开表单的 PoW 难度，默认 3（16^3 次哈希，低端机也是毫秒级）；4/5 更慢更稳
# POW_DIFFICULTY=3

# ── 组织范围 ──────────────────────────────────────────────────
# 可选：仅允许指定 org 使用（逗号分隔的小写 login，留空不限制）
# ALLOWED_ORGS=

# ── 运行模式 ──────────────────────────────────────────────────
# 可选：production 时 Fastify 关闭 pino-pretty 美化输出
# NODE_ENV=production
